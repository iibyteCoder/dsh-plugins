    "@types/node": "^20.19.43",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iibyteCoder/dsh-plugins.git",
    "directory": "packages/session-hub"
